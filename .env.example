TENCENT_APPID=xxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxx
TENCENT_SECRET_ID=xxxxxxxx
DASHSCOPE_API_KEY=xxxxxxxx
ORCAROUTER_API_KEY=xxxxxxxx
DOUBAO_API_KEY=xxxxxxxx
AZURE_SPEECH_KEY=xxxxxxxx
AZURE_TTS_ENDPOINT=xxxxxxxx
DEEPSEEK_API_KEY=xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── 访问边界（安全相关，默认最严：留空即拒绝）───────────────────────────────
# 改完这三项都要重启主服务才生效（跨域配置只在启动期读取）。

# 允许跨域访问管理接口的完整来源，逗号分隔。留空 = 只允许同源访问。
# 不要填通配符 *：通配来源配合凭据正是这次修掉的问题，填了会被当作"不信任任何来源"。
# CORS_ALLOWED_ORIGINS=https://admin.example

# 额外允许作为 /api/avatar/task 的 video_path 的根目录，逗号分隔。
# 服务自己的 data/ 目录（形象素材与上传落盘）本来就允许，这里是**追加**而非替换。
# AVATAR_VIDEO_ROOTS=D:/videos,./assets

# 允许接收头像生成任务状态回调的主机，逗号分隔；写 host 表示任意端口，写 host:port 表示限定端口。
# 留空 = 拒绝一切 notifyurl（含内网地址，可防 SSRF）。
# AVATAR_NOTIFY_ALLOWED_HOSTS=hook.example,127.0.0.1:9000
